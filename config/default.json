{
  "server": {
    "port": 9091,
    "host": "0.0.0.0"
  },
  "agent": {
    "default": null,
    "safeMode": false,
    "paths": {},
    "orchestration": {
      "cli": null,
      "maxConcurrentAgents": 2,
      "namePrefix": "agent",
      "managerName": "manager"
    }
  },
  "chunking": {
    "maxFiles": 8,
    "maxBytes": 262144,
    "maxFilesPerInvocation": 4,
    "maxBytesPerFile": 131072,
    "unitPerCall": "one_subchunk"
  },
  "graph": {
    "minCommunitySize": 3,
    "autoUpdateOnIngest": true,
    "autoUpdateStrategy": "auto",
    "partialThresholds": {
      "minLeaves": 4,
      "minFiles": 16,
      "minBytes": 1048576,
      "minSubChunks": 4
    }
  },
  "search": {
    "qmd": {
      "enabled": true,
      "autoUpdateOnWikiChange": true,
      "scope": "wiki",
      "defaultNoRerank": true,
      "embedEnabled": false
    }
  },
  "chat": {
    "contextTurns": 6,
    "contextMaxBytes": 262144,
    "includeProgressDashboard": true
  },
  "cli": {
    "maxStdoutBytes": 1048576,
    "maxStderrBytes": 262144,
    "promptWarnBytes": 131072,
    "timeouts": {
      "chat": null,
      "ingest": null,
      "ingest-loop": null,
      "preprocess": 3600000,
      "query": 1800000,
      "lint": 1800000,
      "graph": 1800000
    },
    "ingestLoop": {
      "maxIterations": 200,
      "maxRetryAttempts": 3,
      "retryBackoffMs": [5000, 30000]
    }
  },
  "ui": {
    "language": "ko",
    "theme": "default",
    "appSubtitle": "",
    "defaultTab": "chat"
  },
  "auth": {
    "passwordHash": null,
    "sessionSecret": null,
    "sessionTtlSec": 86400
  },
  "publicQuery": {
    "enabled": false,
    "allowExternalLookup": false,
    "sandboxEnabled": true,
    "sandboxReadOnlyHomePaths": [
      ".codex",
      ".claude",
      ".cline",
      ".gemini",
      ".antigravity",
      ".agents",
      ".claude.json",
      ".codex.json",
      ".cline.json",
      ".gemini.json",
      ".config/codex",
      ".config/claude",
      ".config/cline",
      ".config/gemini",
      ".config/anthropic",
      ".config/gcloud",
      ".config/google-cloud",
      ".local/share/codex",
      ".local/share/claude",
      ".local/share/cline",
      ".local/share/gemini",
      ".local/share/anthropic",
      ".local/share/antigravity",
      ".local/state/codex",
      ".local/state/claude",
      ".local/state/cline",
      ".local/state/gemini",
      ".local/state/anthropic",
      ".local/state/antigravity",
      ".cache/codex",
      ".cache/claude",
      ".cache/cline",
      ".cache/gemini",
      ".cache/anthropic",
      ".cache/antigravity"
    ]
  },
  "autoIngest": {
    "enabled": false,
    "mode": "watch",
    "watch": {
      "debounceMs": 5000
    },
    "schedule": {
      "intervalMinutes": 30
    },
    "skipIfBusy": true
  },
  "automation": {
    "enabled": false,
    "maxConcurrentJobs": 2,
    "defaultWorkspaceBasePath": "",
    "jobs": []
  }
}
