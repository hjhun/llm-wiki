{
  "server": {
    "port": 9091,
    "host": "0.0.0.0"
  },
  "agent": {
    "default": null,
    "safeMode": false,
    "paths": {},
    "orchestration": {
      "maxConcurrentAgents": 2,
      "namePrefix": "agent",
      "managerName": "manager"
    }
  },
  "chunking": {
    "maxFiles": 8,
    "maxBytes": 262144,
    "maxFilesPerInvocation": 4,
    "maxBytesPerFile": 131072,
    "unitPerCall": "one_subchunk"
  },
  "graph": {
    "minCommunitySize": 3,
    "autoUpdateOnIngest": true,
    "autoUpdateStrategy": "auto",
    "partialThresholds": {
      "minLeaves": 4,
      "minFiles": 16,
      "minBytes": 1048576,
      "minSubChunks": 4
    }
  },
  "chat": {
    "contextTurns": 6,
    "includeProgressDashboard": true
  },
  "cli": {
    "maxStdoutBytes": 1048576,
    "maxStderrBytes": 262144,
    "promptWarnBytes": 131072,
    "timeouts": {
      "chat": 1800000,
      "ingest": null,
      "ingest-loop": null,
      "preprocess": 3600000,
      "query": 1800000,
      "lint": 1800000,
      "graph": 1800000
    },
    "ingestLoop": {
      "maxIterations": 200,
      "maxRetryAttempts": 3,
      "retryBackoffMs": [5000, 30000]
    }
  },
  "ui": {
    "language": "ko",
    "theme": "default",
    "defaultTab": "chat"
  },
  "auth": {
    "passwordHash": null,
    "sessionSecret": null,
    "sessionTtlSec": 86400
  },
  "autoIngest": {
    "enabled": false,
    "mode": "watch",
    "watch": {
      "debounceMs": 5000
    },
    "schedule": {
      "intervalMinutes": 30
    },
    "skipIfBusy": true
  },
  "automation": {
    "enabled": false,
    "maxConcurrentJobs": 2,
    "defaultWorkspaceBasePath": "",
    "jobs": []
  }
}
