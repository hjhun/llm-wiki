{
  "name": "llm-wiki-app",
  "private": true,
  "version": "0.9.11",
  "license": "Apache-2.0",
  "description": "Local web UI for the LLM Wiki pattern. Chat, Explorer, Graph, Settings on top of raw/ + wiki/.",
  "scripts": {
    "dev": "node scripts/next-from-config.mjs dev",
    "dev:lan": "node scripts/next-from-config.mjs dev --lan",
    "build": "next build",
    "start": "node scripts/next-from-config.mjs start",
    "start:lan": "node scripts/next-from-config.mjs start --lan",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chokidar": "^5.0.0",
    "cytoscape": "^3.33.3",
    "jose": "^6.2.3",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.15.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
