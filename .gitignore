# ── Node / Next.js ─────────────────────────────────────────────
node_modules/
.pnpm-store/
.next/
out/
dist/
build/
*.tsbuildinfo
.npm/
.yarn/
.pnp.*

# ── Env / Secrets ──────────────────────────────────────────────
.env
.env.*
!.env.example
config/local.json
config/cli-detected.json

# ── 레거시/로컬 보조 도구 ─────────────────────────────────────
# graphify는 글로벌 설치본을 사용한다. 과거 로컬 클론이 남아 있으면 추적하지 않음.
tools/graphify/

# ── 위키 운영 산출물 (자동 생성) ───────────────────────────────
# 사용자가 git으로 위키를 백업하길 원하면 이 라인들을 주석 처리.
wiki/graph/parts/
wiki/graph/.state.json

# Ingest progress: DASHBOARD.md, .state.json, and leaves/ are committed so the
# work can resume on another machine. Only the lock file and tmp/ are ignored.
wiki/.progress/ingest/.lock
wiki/.progress/ingest/tmp/

# ── 채팅 세션 / CLI 로그 ───────────────────────────────────────
# 개인 기록이라 기본은 추적하지 않음. 필요 시 주석 처리하면 백업 가능.
sessions/
!sessions/.gitkeep

# ── OS / Editor ────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# ── 로그 / 임시 ────────────────────────────────────────────────
*.log
*.pid
*.seed
*.tmp
.cache/
coverage/
